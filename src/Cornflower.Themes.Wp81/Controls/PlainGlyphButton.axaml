<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wp81="using:Cornflower.Themes.Wp81">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/SplitButton/README.md.

    A part theme (plan section 3): the borderless button inside a larger control's border, for a glyph (a chevron, an
    arrow) or a part's own content. SplitButton's two parts wear it (#235); later batches reuse it. Keyed, so it reaches
    only the templates that name it, by DynamicResource (a StaticResource finds only its own file's).

    Nothing drawn at rest: a transparent background, no border, and the foreground its host's (it sets none, so it
    inherits). Pressed fills it with the accent and draws its content over it in PhoneButtonBasePressedForegroundBrush,
    as a checked ToggleButton's; disabled draws the content in PhoneDisabledBrush. No size of its own: a part inside a
    larger control takes the host's (rule 6), and fills its slot. No tilt of its own: its host decides (SplitButton tilts
    as a whole). No focus adorner: the theme sets none, as the phone's buttons have none.
  -->
  <ControlTheme x:Key="Wp81PlainGlyphButtonTheme" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource CornflowerPlainGlyphButtonPadding}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Border" Background="{TemplateBinding Background}">
          <ContentPresenter x:Name="PART_ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True"
                            wp81:PhoneContentLine.IsEnabled="True" />
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource PhoneAccentBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource PhoneButtonBasePressedForegroundBrush}" />
      </Style>
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource PhoneDisabledBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
