<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cf="using:Cornflower.Controls"
                    xmlns:wp81="using:Cornflower.Themes.Wp81">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/DropDownButton/README.md.

    An 8.1 app put a Flyout or a MenuFlyout on a Button; Avalonia's DropDownButton is that Button with a chevron. So this
    is Wp81's Button (Controls/Button.axaml) with a chevron after the content: the same setters, by the phone's keys, the
    same untilted Root, tilted Grid and Border inside PhoneTouchTargetOverhang, the same pressed and disabled looks, the
    tilt and HoleParts' fallback. Written out here, not BasedOn the Button's theme, as a StaticResource finds only its
    own file's resources. The chevron is Lucide's ChevronDown (rule 10), in the content's foreground, after it by
    CornflowerPlainChevronMargin. An open flyout changes nothing drawn (rule 3: the accent isn't for open).
  -->
  <ControlTheme x:Key="{x:Type DropDownButton}" TargetType="DropDownButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource PhoneForegroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PhoneForegroundBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource PhoneBorderThickness}" />
    <Setter Property="FontFamily" Value="{DynamicResource PhoneFontFamilyNormal}" />
    <Setter Property="FontWeight" Value="{DynamicResource PhoneButtonFontWeight}" />
    <Setter Property="FontSize" Value="{DynamicResource TextStyleLargeFontSize}" />
    <Setter Property="Padding" Value="{DynamicResource PhoneButtonContentPadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource PhoneButtonMinHeight}" />
    <Setter Property="MinWidth" Value="{DynamicResource PhoneButtonMinWidth}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="cf:Tilt.IsEnabled" Value="True" />
    <!-- In the template of a control Wp81 doesn't theme yet, the theme under Wp81's DropDownButton instead (HoleParts). -->
    <Setter Property="wp81:HoleParts.FallBack" Value="True" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel x:Name="Root" Background="Transparent">
          <Panel x:Name="Grid" cf:Tilt.IsTarget="True">
            <Border x:Name="Border"
                    Margin="{DynamicResource PhoneTouchTargetOverhang}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Grid Margin="{TemplateBinding Padding}" ColumnDefinitions="*,Auto">
                <ContentPresenter x:Name="PART_ContentPresenter"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  RecognizesAccessKey="True"
                                  wp81:PhoneContentLine.IsEnabled="True" />
                <cf:LucideIcon x:Name="Chevron"
                               Grid.Column="1"
                               Kind="ChevronDown"
                               Margin="{DynamicResource CornflowerPlainChevronMargin}"
                               VerticalAlignment="Center" />
              </Grid>
            </Border>
          </Panel>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pressed">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedBackgroundThemeBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForegroundThemeBrush}" />
      </Style>
      <Style Selector="^ /template/ cf|LucideIcon#Chevron">
        <Setter Property="Foreground" Value="{DynamicResource ButtonPressedForegroundThemeBrush}" />
      </Style>
    </Style>

    <Style Selector="^:disabled">
      <Style Selector="^ /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackgroundThemeBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDisabledBorderThemeBrush}" />
      </Style>
      <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundThemeBrush}" />
      </Style>
      <Style Selector="^ /template/ cf|LucideIcon#Chevron">
        <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundThemeBrush}" />
      </Style>
    </Style>
  </ControlTheme>
</ResourceDictionary>
