<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cf="using:Cornflower.Controls">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/PipsPager/README.md.

    PipsPager, by type (#241): 8.1 had nothing like it, so this is Metro's flat mark in its place. A row (or, with
    Orientation Vertical, a column) of small square marks, CornflowerPlainPipSize across, each centred in a square a
    fingertip wide (CornflowerPlainPipTargetSize), with no circles, no shadows and no space between the squares. An
    unselected mark is the foreground at the phone's low opacity (PhoneLowBrush); the selected one is the accent
    (PhoneAccentBrush), as a selection is state (rule 3); a pressed one the full foreground, under the finger; disabled,
    the selected one PhoneDisabledBrush. No size change and no tilt: the marks are smaller than an item (rule 7).

    The arrows are plain Buttons, as Avalonia's template has them, in the plain glyph button part
    (Wp81PlainGlyphButtonTheme, by DynamicResource, through PreviousButtonTheme and NextButtonTheme), each the same
    fingertip square, with Lucide's chevrons (rule 10): left and right, up and down when vertical. At the first and the
    last page the arrow that can't go on is disabled, Avalonia's own, and drawn dimmed, not hidden.

    No motion of its own (rule 8): Simple's colour transitions on the marks and the arrows are left out. The overflow
    row's slide to the selected mark (MaxVisiblePips) is Avalonia's PipsPager's own code, kept.

    The marks are a ListBox (PART_PipsPagerList) in a theme of this file's own, Wp81PlainPipsListTheme: transparent, in
    Wp81's bar-less ScrollViewer, AutoScrollToSelectedItem off and ListBoxOptions.KeepsScrollInList on, so neither a
    selection at load, a SelectedPageIndex set in code nor a tap on a mark scrolls the page round the pager (#220);
    its items wear Wp81PlainPipTheme.
  -->

  <ControlTheme x:Key="Wp81PlainPipTheme" TargetType="ListBoxItem">
    <Setter Property="Width" Value="{DynamicResource CornflowerPlainPipTargetSize}" />
    <Setter Property="Height" Value="{DynamicResource CornflowerPlainPipTargetSize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="{TemplateBinding Background}">
          <Rectangle x:Name="Pip"
                     Width="{DynamicResource CornflowerPlainPipSize}"
                     Height="{DynamicResource CornflowerPlainPipSize}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Fill="{DynamicResource PhoneLowBrush}" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pressed /template/ Rectangle#Pip">
      <Setter Property="Fill" Value="{DynamicResource PhoneForegroundBrush}" />
    </Style>
    <!-- After the press, so the selected mark stays the accent under the finger. -->
    <Style Selector="^:selected /template/ Rectangle#Pip">
      <Setter Property="Fill" Value="{DynamicResource PhoneAccentBrush}" />
    </Style>
    <Style Selector="^:selected:disabled /template/ Rectangle#Pip">
      <Setter Property="Fill" Value="{DynamicResource PhoneDisabledBrush}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="Wp81PlainPipsListTheme" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="cf:ListBoxOptions.KeepsScrollInList" Value="True" />
    <Setter Property="ItemContainerTheme" Value="{DynamicResource Wp81PlainPipTheme}" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource FindAncestor, AncestorType=PipsPager}}" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer x:Name="PART_ScrollViewer"
                      Theme="{DynamicResource Wp81ScrollViewerScrollBarlessTheme}"
                      Background="{TemplateBinding Background}"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Hidden">
          <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type PipsPager}" TargetType="PipsPager">
    <Setter Property="Foreground" Value="{DynamicResource PhoneForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="PreviousButtonTheme" Value="{DynamicResource Wp81PlainGlyphButtonTheme}" />
    <Setter Property="NextButtonTheme" Value="{DynamicResource Wp81PlainGlyphButtonTheme}" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel x:Name="PART_RootPanel"
                    Orientation="{TemplateBinding Orientation}"
                    Background="{TemplateBinding Background}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <Button x:Name="PART_PreviousButton"
                  Theme="{TemplateBinding PreviousButtonTheme}"
                  Width="{DynamicResource CornflowerPlainPipTargetSize}"
                  Height="{DynamicResource CornflowerPlainPipTargetSize}"
                  Padding="0"
                  IsVisible="{TemplateBinding IsPreviousButtonVisible}">
            <cf:LucideIcon x:Name="PreviousGlyph" Kind="ChevronLeft" />
          </Button>
          <ListBox x:Name="PART_PipsPagerList"
                   Theme="{DynamicResource Wp81PlainPipsListTheme}"
                   ItemsSource="{Binding TemplateSettings.Pips, RelativeSource={RelativeSource TemplatedParent}}"
                   SelectedIndex="{Binding SelectedPageIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
          <Button x:Name="PART_NextButton"
                  Theme="{TemplateBinding NextButtonTheme}"
                  Width="{DynamicResource CornflowerPlainPipTargetSize}"
                  Height="{DynamicResource CornflowerPlainPipTargetSize}"
                  Padding="0"
                  IsVisible="{TemplateBinding IsNextButtonVisible}">
            <cf:LucideIcon x:Name="NextGlyph" Kind="ChevronRight" />
          </Button>
        </StackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:vertical /template/ cf|LucideIcon#PreviousGlyph">
      <Setter Property="Kind" Value="ChevronUp" />
    </Style>
    <Style Selector="^:vertical /template/ cf|LucideIcon#NextGlyph">
      <Setter Property="Kind" Value="ChevronDown" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
