<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cf="using:Cornflower.Controls">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/ButtonSpinner/README.md.

    The phone had no spinner. Here a ButtonSpinner is a box with its content and two spin buttons in it: the box in
    PhoneBorderThickness (2.5, rule 4: a box a finger presses) and PhoneForegroundBrush, transparent at rest, at least the
    phone's text box tall (TextControlThemeMinHeight), its content in the body's size and family (ContentControlFontSize,
    as Wp81's TextBox) inside TextControlThemePadding. PART_DecreaseButton (Lucide's Minus) and PART_IncreaseButton
    (Plus), rule 10, side by side, as a finger finds them more easily than two stacked halves, each in the spin button
    part theme (Wp81PlainSpinnerButtonTheme): nothing drawn at rest, the accent while pressed. They sit after the content
    (ButtonSpinnerLocation Right, Avalonia's default, :right) or before it (:left), and go with ShowButtonSpinner. Avalonia
    enables each from AllowSpin and ValidSpinDirection. Disabled draws the box in PhoneDisabledBrush. No tilt: a box, not
    a button (rule 7); its buttons are the phone's RepeatButton's kind, which has none.
  -->
  <ControlTheme x:Key="{x:Type ButtonSpinner}" TargetType="ButtonSpinner">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource PhoneForegroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PhoneForegroundBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource PhoneBorderThickness}" />
    <Setter Property="FontFamily" Value="{DynamicResource PhoneFontFamilyNormal}" />
    <Setter Property="FontSize" Value="{DynamicResource ContentControlFontSize}" />
    <Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
    <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
          <!-- Columns 0 and 1 hold the buttons on the left, 3 and 4 on the right; the empty two are 0 wide. -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Column="2"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" />
            <RepeatButton x:Name="PART_DecreaseButton"
                          Grid.Column="3"
                          Theme="{DynamicResource Wp81PlainSpinnerButtonTheme}"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
              <cf:LucideIcon Kind="Minus" />
            </RepeatButton>
            <RepeatButton x:Name="PART_IncreaseButton"
                          Grid.Column="4"
                          Theme="{DynamicResource Wp81PlainSpinnerButtonTheme}"
                          IsVisible="{TemplateBinding ShowButtonSpinner}">
              <cf:LucideIcon Kind="Plus" />
            </RepeatButton>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:left">
      <Style Selector="^ /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Grid.Column" Value="0" />
      </Style>
      <Style Selector="^ /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Grid.Column" Value="1" />
      </Style>
    </Style>

    <Style Selector="^:disabled /template/ Border#Border">
      <Setter Property="BorderBrush" Value="{DynamicResource PhoneDisabledBrush}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
