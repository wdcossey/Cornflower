<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cf="using:Cornflower.Controls"
                    xmlns:wp81="using:Cornflower.Themes.Wp81">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/TableViewCell/README.md.

    A table's cell: its column's value in the row's type (the body's, set on the row) and colour, left-aligned unless
    its column says otherwise (TableViewColumn.HorizontalContentAlignment), centred in the row's height. No grid lines
    and no box, as Metro's lists had none: the row's rule is the only line. CornflowerPlainTableCellPadding puts 9.5
    after the text and nothing before it, so the first column's text lines up with the page's and with its header's,
    and the columns stand 9.5 apart. PART_ContentPresenter gives the text the phone's 1.33 em line (PhoneHeaderLine:
    it recognises no access keys), as the tree's row does. A column's own CellTheme replaces this one.
  -->
  <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
    <Setter Property="Padding" Value="{DynamicResource CornflowerPlainTableCellPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          wp81:PhoneHeaderLine.IsEnabled="True" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
