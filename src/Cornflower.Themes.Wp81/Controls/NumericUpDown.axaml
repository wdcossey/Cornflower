<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/NumericUpDown/README.md.

    An 8.1 app used a TextBox with the number keyboard (InputScope Number). So a NumericUpDown here is Wp81's TextBox,
    by type, with the phone's box, focus, placeholder and disabled looks, and the number keyboard
    (TextInputOptions.ContentType Number), inside a ButtonSpinner, by type (Controls/ButtonSpinner.axaml), whose own box
    is cleared, so its spin buttons sit beside the TextBox's box, as tall as it. The control takes the TextBox's margin
    (TextControlMarginThemeThickness), so it sits on a page as a TextBox does, and the TextBox inside has none. The
    spinner's AllowSpin, ShowButtonSpinner and ButtonSpinnerLocation, and the box's Text (both ways), PlaceholderText,
    IsReadOnly and TextAlignment, are the control's; Avalonia's NumericUpDown keeps its Text and Value in step.
  -->
  <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
    <Setter Property="Margin" Value="{DynamicResource TextControlMarginThemeThickness}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ButtonSpinner x:Name="PART_Spinner"
                       Background="Transparent"
                       BorderThickness="0"
                       Padding="0"
                       AllowSpin="{TemplateBinding AllowSpin}"
                       ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                       ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}">
          <TextBox x:Name="PART_TextBox"
                   Margin="0"
                   Text="{TemplateBinding Text, Mode=TwoWay}"
                   PlaceholderText="{TemplateBinding PlaceholderText}"
                   IsReadOnly="{TemplateBinding IsReadOnly}"
                   TextAlignment="{TemplateBinding TextAlignment}"
                   AcceptsReturn="False"
                   TextWrapping="NoWrap"
                   TextInputOptions.ContentType="Number" />
        </ButtonSpinner>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
