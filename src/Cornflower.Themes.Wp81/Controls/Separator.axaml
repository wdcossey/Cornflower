<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/Separator/README.md.

    The phone's separators were the MenuFlyout's and the AppBar's (Wp81MenuFlyoutSeparatorTheme, keyed, is the phone's
    inside a menu, and still applies there). Outside a menu a Separator is a line across its slot, in the line thickness
    (CornflowerPlainLineThickness, 1.5) and PhoneLowBrush, quiet at rest: no accent, no margin of its own (the page
    spaces it), not focusable. The line is the separator's Background, as Simple's and Fluent's are, and as tall as the
    top of its BorderThickness, so the one all-sides token sets it and an app's Background or BorderThickness changes it.
  -->
  <ControlTheme x:Key="{x:Type Separator}" TargetType="Separator">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="{DynamicResource PhoneLowBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource CornflowerPlainLineThickness}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Line"
                Height="{Binding BorderThickness.Top, RelativeSource={RelativeSource TemplatedParent}}"
                Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
