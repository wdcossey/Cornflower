<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/TabStrip/README.md.

    The phone had no TabStrip. Here it is the Pivot's header row, as the plain TabControl's (Controls/TabControl.axaml):
    its items are the plain TabStripItem's headers (Controls/TabStripItem.axaml), in a StackPanel (PART_ItemsPresenter)
    in Wp81's ScrollViewerScrollBarlessTheme (PART_ScrollViewer), which a finger pans to reach a header past the edge,
    with no bar; its Background, Transparent, takes a finger in the Padding too. Transparent at rest (rule 5); no motion
    (rule 8). AutoScrollToSelectedItem is off, as the TabControl's: bringing the selected header into view would scroll
    the page round the strip.

      <TabStrip SelectedIndex="0">
        <TabStripItem Content="all" />
        <TabStripItem Content="unread" />
      </TabStrip>
  -->
  <ControlTheme x:Key="{x:Type TabStrip}" TargetType="TabStrip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="AutoScrollToSelectedItem" Value="False" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer x:Name="PART_ScrollViewer"
                      Theme="{DynamicResource Wp81ScrollViewerScrollBarlessTheme}"
                      Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
