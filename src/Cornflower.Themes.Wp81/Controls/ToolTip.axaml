<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wp81="using:Cornflower.Themes.Wp81">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/ToolTip/README.md.

    The phone had no tooltip: touch has no hover, so it shows only with a pointer. A floating surface, so the flyout's
    FlyoutBackgroundThemeBrush (PhoneChromeColor, rule 5), with no border, as the flyout has none, square. Its text is
    the phone's family at TextStyleMediumFontSize (16), the small print's size (rule 2), in PhoneForegroundBrush, with
    the phone's 1.33 em line for the text it makes (PhoneHeaderLine), inside CornflowerPlainToolTipPadding. No motion:
    the popup opens and closes as Avalonia's does (rule 8).
  -->
  <ControlTheme x:Key="{x:Type ToolTip}" TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource FlyoutBackgroundThemeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PhoneForegroundBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource PhoneFontFamilyNormal}" />
    <Setter Property="FontSize" Value="{DynamicResource TextStyleMediumFontSize}" />
    <Setter Property="Padding" Value="{DynamicResource CornflowerPlainToolTipPadding}" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter x:Name="PART_ContentPresenter"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          wp81:PhoneHeaderLine.IsEnabled="True" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
