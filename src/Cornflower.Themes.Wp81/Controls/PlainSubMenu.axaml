<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Plain theme: Cornflower's design in the era's style, not a reproduction. Nothing in it is measured from the phone.
    ADR 0007 (docs/decisions/0007-plain-themes.md); docs/controls/MenuItem/README.md.

    A sub-menu's surface, Wp81PlainSubMenuTheme (Border): the Border round a sub-menu's items, in the popup a MenuItem
    opens (a menu bar's drop-down, or a sub-menu of a menu). The MenuFlyout's own look (rule 5): its background
    (MenuFlyoutBackgroundThemeBrush), its line (MenuFlyoutBorderThemeBrush) in the plain 1.5 all round
    (CornflowerPlainLineThickness), square, inside CornflowerPlainSubMenuPadding. The items' type is their own (the
    MenuItem theme's): they inherit from the item above them, not from this. The MenuItem and Menu templates wear it by
    DynamicResource.
  -->
  <ControlTheme x:Key="Wp81PlainSubMenuTheme" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource MenuFlyoutBackgroundThemeBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MenuFlyoutBorderThemeBrush}" />
    <Setter Property="BorderThickness" Value="{DynamicResource CornflowerPlainLineThickness}" />
    <Setter Property="Padding" Value="{DynamicResource CornflowerPlainSubMenuPadding}" />
  </ControlTheme>
</ResourceDictionary>
