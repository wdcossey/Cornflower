<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The plain themes' own tokens (ADR 0007, docs/decisions/0007-plain-themes.md): values for controls the phone never had,
    Cornflower's design, not measured. Each key is prefixed CornflowerPlain, never a WinRT-shaped name (...ThemeBrush,
    ...ThemeThickness), which in this repo means the phone's value. A batch that needs one adds it here, with its reason.
  -->

  <!--
    A line that divides or edges a surface (a separator, a table's rule, a pane's edge): 1.5, the AppBar's and the
    MenuFlyout's edge thickness, on all sides, as the phone's own 1.5 keys are one-sided (AppBarTopBorderThemeThickness is
    0,0,0,1.5). A box a finger presses or types in takes PhoneBorderThickness (2.5) instead.
  -->
  <Thickness x:Key="CornflowerPlainLineThickness">1.5</Thickness>

  <!--
    The same 1.5 line as a length, for a line drawn across a box rather than round it: the divider between a
    SplitButton's two parts (#235), where an all-sides Thickness would draw it twice as wide.
  -->
  <x:Double x:Key="CornflowerPlainLineWidth">1.5</x:Double>

  <!--
    A borderless button part's padding (Wp81PlainGlyphButtonTheme, #235): 9.5 each side of its glyph, the phone's
    PhoneButtonContentPadding's sides, with none above or below, as a glyph needs no room for a text line's descent.
  -->
  <Thickness x:Key="CornflowerPlainGlyphButtonPadding">9.5,0</Thickness>

  <!-- The room between a button's content and the chevron after it (DropDownButton, #235): the same 9.5. -->
  <Thickness x:Key="CornflowerPlainChevronMargin">9.5,0,0,0</Thickness>

  <!--
    A spin button's least width (Wp81PlainSpinnerButtonTheme, #235): a part inside a larger control (rule 6), as tall as
    the box beside it (TextControlThemeMinHeight, 34), and a little wider, so each of the two takes a fingertip.
  -->
  <x:Double x:Key="CornflowerPlainSpinnerButtonMinWidth">40</x:Double>

  <!--
    A spin button's repeat (Wp81PlainSpinnerButtonTheme, #235): the phone's own RepeatButton's Delay and Interval
    (Controls/RepeatButton.axaml), so a held spin button repeats as a held RepeatButton does on the phone.
  -->
  <x:Int32 x:Key="CornflowerPlainSpinnerButtonDelay">500</x:Int32>
  <x:Int32 x:Key="CornflowerPlainSpinnerButtonInterval">33</x:Int32>

  <!--
    A GridSplitter's least width and height (#235): 9.5, the phone's touch-target overhang (PhoneTouchTargetOverhang's
    9.5), so a bar a finger can find, thin beside the panes. An app's own Width or Height wins.
  -->
  <x:Double x:Key="CornflowerPlainSplitterMinSize">9.5</x:Double>

  <!--
    The room under a group's heading (GroupBox, #236): 9.5, the phone's touch-target overhang (PhoneTouchTargetOverhang's
    9.5), twice the control header's 4.8 (TextControlHeaderMarginThemeThickness), as a group heads more than one control.
  -->
  <Thickness x:Key="CornflowerPlainGroupHeaderMargin">0,0,0,9.5</Thickness>

  <!--
    A tooltip's padding (ToolTip, #236): 9.5 each side, the phone's PhoneButtonContentPadding's sides, and 4.8 above and
    below, the control header's gap (TextControlHeaderMarginThemeThickness), so a line of small print sits snug.
  -->
  <Thickness x:Key="CornflowerPlainToolTipPadding">9.5,4.8</Thickness>

  <!--
    A menu item's icon or check (MenuItem, #237): 20 square, LucideIcon's own size (Controls/LucideIcon.axaml), so a
    Lucide icon fits it as drawn; the check is the theme's Wp81.Glyph.CheckMark, fitted to it. 9.5 after it, the phone's
    PhoneButtonContentPadding's sides, before the header.
  -->
  <x:Double x:Key="CornflowerPlainMenuItemIconSize">20</x:Double>
  <Thickness x:Key="CornflowerPlainMenuItemIconMargin">0,0,9.5,0</Thickness>

  <!-- A radio item's dot (MenuItem, #237): the icon's 20 less 5 all round, a 10 dot, half the icon's size. -->
  <Thickness x:Key="CornflowerPlainMenuItemRadioMargin">5</Thickness>

  <!--
    The room before a menu item's gesture text (MenuItem, #237): 19, the MenuFlyout's left padding
    (MenuFlyoutPortraitThemePadding), so a shortcut stands as far from its header as the header from the menu's edge.
  -->
  <Thickness x:Key="CornflowerPlainMenuItemGestureMargin">19,0,0,0</Thickness>

  <!--
    A sub-menu's padding (MenuItem and Menu, #237): 19 at the sides, the MenuFlyout's left padding
    (MenuFlyoutPortraitThemePadding), so its items' text sits as a MenuFlyout's does; 8.5 above and below, an item's own
    (MenuFlyoutItemThemePadding). A sub-menu isn't the window's width, so it has a right side too. The 19 at the sides
    also indents a Separator in it with the items' text, as Simple's indent does.
  -->
  <Thickness x:Key="CornflowerPlainSubMenuPadding">19,8.5</Thickness>

  <!--
    A menu bar's item (Menu, #237): 9.5 at the sides, the phone's PhoneButtonContentPadding's, and 8.5 above and below,
    a MenuFlyout item's (MenuFlyoutItemThemePadding), round its header in the body's size.
  -->
  <Thickness x:Key="CornflowerPlainTopLevelMenuItemPadding">9.5,8.5</Thickness>

  <!--
    A tab's header before it (TabItem and TabStripItem, #238): 16 to the left, the Pivot header's room before it
    (PivotHeaderItemMargin's 16), without the Pivot's -6.5 above, which tucks a header up under the Pivot's title. A tab
    strip has no title, and a header pulled 6.5 above the strip would be clipped by it.
  -->
  <Thickness x:Key="CornflowerPlainTabHeaderMargin">16,0,0,0</Thickness>

  <!--
    A row's rule (Wp81PlainRowTheme: a tree's row, #239, and batch 9's table rows): the 1.5 line (rule 4: a line that
    divides), under the row only, so the rows of a list are divided once each, not twice.
  -->
  <Thickness x:Key="CornflowerPlainRuleThickness">0,0,0,1.5</Thickness>

  <!--
    A tree's indent per level, and its chevron's column (TreeViewItem, #239): 38.5, a phone Button's box
    (PhoneButtonMinHeight's 57.5 less PhoneTouchTargetOverhang's 9.5 above and below), so the chevron takes a fingertip
    across the row's height, and a child's chevron sits under its parent's header.
  -->
  <x:Double x:Key="CornflowerPlainTreeViewItemIndent">38.5</x:Double>

  <!--
    A DrawerPage's bar (#239): 48, Avalonia's NavigationPage.BarHeight default, which Wp81's NavigationPage bar keeps, so a
    drawer's bar and a navigation bar are the same height. Its drawer button is as wide, a square.
  -->
  <x:Double x:Key="CornflowerPlainDrawerBarHeight">48</x:Double>

  <!--
    A DrawerPage's title in its bar (#239): 12 each side, the room Wp81's NavigationPage leaves after its header
    (PART_Header's 0,0,12,0), on both sides, so a title stands off the bar's edge with the drawer on either side.
  -->
  <Thickness x:Key="CornflowerPlainDrawerTitleMargin">12,0</Thickness>

  <!--
    A validation error's text (DataValidationErrors, #241): the Red accent (CornflowerAccentRedColor, the phone's own
    Red), the same in dark and light (ADR 0007), as red reads as an error on either page. Red is a fixed colour, not the
    user's accent, so an error never takes the accent's place.
  -->
  <SolidColorBrush x:Key="CornflowerPlainErrorBrush" Color="{DynamicResource CornflowerAccentRedColor}" />

  <!--
    A notification's type (NotificationCard, #241), as the line under its banner: Success the Green accent
    (CornflowerAccentGreenColor), Warning the Amber (CornflowerAccentAmberColor), Error the error's red above;
    Information none. Fixed colours, the same in dark and light, as the error's, so a type never takes the accent's place.
  -->
  <SolidColorBrush x:Key="CornflowerPlainSuccessBrush" Color="{DynamicResource CornflowerAccentGreenColor}" />
  <SolidColorBrush x:Key="CornflowerPlainWarningBrush" Color="{DynamicResource CornflowerAccentAmberColor}" />

  <!--
    A notification banner's text inside it (NotificationCard, #241): 19 before it, the MenuFlyout's left padding
    (MenuFlyoutPortraitThemePadding), so its text lines up with a page's; 9.5 above and below, the phone's touch-target
    overhang (PhoneTouchTargetOverhang). None after it: the close button follows, a fingertip wide.
  -->
  <Thickness x:Key="CornflowerPlainNotificationPadding">19,9.5,0,9.5</Thickness>
</ResourceDictionary>
