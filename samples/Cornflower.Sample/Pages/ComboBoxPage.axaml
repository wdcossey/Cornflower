<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cf="using:Cornflower.Controls"
             xmlns:sample="using:Cornflower.Sample"
             x:Class="Cornflower.Sample.Pages.ComboBoxPage"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
             Foreground="{DynamicResource PhoneForegroundBrush}"
             FontFamily="{DynamicResource PhoneFontFamilyNormal}"
             FontSize="{DynamicResource TextStyleLargeFontSize}">
  <!--
    The 8.1 ComboBox, as an 8.1 page writes one: no style, no size, the header by cf:ControlHeader.Header (WinRT's
    Header). Five items or fewer open in place; six or more open the full-screen list picker. What is picked shows
    below the first two.
  -->
  <ScrollViewer>
    <StackPanel Margin="19,12,19,24">
      <sample:SamplePageHeader x:Name="Header" />

      <TextBlock Text="five items: inline" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
      <ComboBox x:Name="Inline" cf:ControlHeader.Header="size" SelectedIndex="2" SelectionChanged="OnSelectionChanged">
        <x:String>extra small</x:String>
        <x:String>small</x:String>
        <x:String>medium</x:String>
        <x:String>large</x:String>
        <x:String>extra large</x:String>
      </ComboBox>

      <TextBlock Text="seven items: full screen" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <ComboBox x:Name="Full" cf:ControlHeader.Header="colour" SelectedIndex="4" SelectionChanged="OnSelectionChanged">
        <x:String>red</x:String>
        <x:String>orange</x:String>
        <x:String>yellow</x:String>
        <x:String>green</x:String>
        <x:String>blue</x:String>
        <x:String>indigo</x:String>
        <x:String>violet</x:String>
      </ComboBox>
      <TextBlock x:Name="State" Theme="{DynamicResource ControlContextualInfoTextBlockStyle}" />

      <TextBlock Text="nothing picked" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <ComboBox x:Name="Placeholder" cf:ControlHeader.Header="day">
        <x:String>today</x:String>
        <x:String>tomorrow</x:String>
        <x:String>next week</x:String>
      </ComboBox>

      <TextBlock Text="disabled" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <ComboBox x:Name="Disabled" cf:ControlHeader.Header="ringtone" SelectedIndex="0" IsEnabled="False">
        <x:String>chimes</x:String>
        <x:String>bells</x:String>
      </ComboBox>

      <ThemeVariantScope RequestedThemeVariant="Light" Margin="-19,12,-19,0">
        <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}" Padding="19,6,19,12">
          <StackPanel>
            <TextBlock Text="light" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
            <ComboBox x:Name="Light" cf:ControlHeader.Header="combo box" SelectedIndex="0">
              <x:String>one</x:String>
              <x:String>two</x:String>
              <x:String>three</x:String>
            </ComboBox>
          </StackPanel>
        </Border>
      </ThemeVariantScope>
    </StackPanel>
  </ScrollViewer>
</UserControl>
