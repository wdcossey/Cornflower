<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sample="using:Cornflower.Sample"
             x:Class="Cornflower.Sample.Pages.ListViewPage"
             Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
             Foreground="{DynamicResource PhoneForegroundBrush}"
             FontFamily="{DynamicResource PhoneFontFamilyNormal}"
             FontSize="{DynamicResource TextStyleLargeFontSize}">
  <!--
    The 8.1 ListView, as an 8.1 page writes one: Avalonia's ListBox with no style, its items in the phone's
    ListViewItemTextBlockStyle and ListViewItemSubheaderTextBlockStyle. Press an item to see the tilt; drag to pan the
    list, which lets the item go; tap to select it, which the phone draws as nothing. "select" puts the list in the
    check mode (SelectionMode Multiple and Toggle, WinRT's Multiple): the check boxes slide in, and a tap checks an
    item. Below: strings with no template (the phone's small 12 px text), a disabled list, and the light theme.
  -->
  <ScrollViewer>
    <StackPanel Margin="19,12,19,24">
      <sample:SamplePageHeader x:Name="Header" />

      <TextBlock Text="default" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
      <ToggleButton x:Name="Select" Content="select" IsCheckedChanged="OnSelectChanged" />
      <TextBlock x:Name="State" Theme="{DynamicResource ControlContextualInfoTextBlockStyle}" />
      <ListBox x:Name="Default" Height="300" Margin="0,6,0,0" SelectionChanged="OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,0,0,9.5">
              <TextBlock Text="{Binding}" Theme="{DynamicResource ListViewItemTextBlockStyle}" />
              <TextBlock Text="a second line" Theme="{DynamicResource ListViewItemSubheaderTextBlockStyle}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="strings" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <ListBox x:Name="Strings" Height="120" />

      <TextBlock Text="disabled" Theme="{DynamicResource GroupHeaderTextBlockStyle}" Margin="0,12,0,0" />
      <ListBox x:Name="Disabled" Height="120" IsEnabled="False" SelectionMode="Multiple,Toggle" />

      <ThemeVariantScope RequestedThemeVariant="Light" Margin="-19,12,-19,0">
        <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}" Padding="19,6,19,12">
          <StackPanel>
            <TextBlock Text="light" Theme="{DynamicResource GroupHeaderTextBlockStyle}" />
            <ListBox x:Name="Light" Height="160" SelectionMode="Multiple,Toggle" />
          </StackPanel>
        </Border>
      </ThemeVariantScope>
    </StackPanel>
  </ScrollViewer>
</UserControl>
